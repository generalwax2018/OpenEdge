# OpenEdge Caddyfile — single-node production ready
# Global options
{
	email {$ACME_EMAIL}
	# admin off   # uncomment for production if you don't need the admin API

	# CrowdSec bouncer
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
	}

	# Order matters
	order coraza_waf first
	order crowdsec_http before reverse_proxy
	order rate_limit before reverse_proxy
}

# Default site (replace {$DOMAIN} or hardcode your domain)
{$DOMAIN} {
	# Security headers (Cloudflare-like)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Rate limiting (per IP) — tune for your traffic
	# Default: 100 requests / minute per IP. Adjust events/window as needed.
	rate_limit {
		zone default {
			key {remote_host}
			events 100
			window 1m
		}
	}

	# Coraza WAF with OWASP CRS
	# Start in DetectionOnly, switch to On after tuning false positives
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine DetectionOnly
			# SecRuleEngine On
		`
	}

	# CrowdSec IP blocking
	crowdsec

	# Reverse proxy to upstream
	reverse_proxy {$UPSTREAM} {
		# Preserve client IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Access logging (CrowdSec reads these)
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}
}

# Optional: redirect HTTP to HTTPS is handled automatically by Caddy
