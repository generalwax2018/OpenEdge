# OpenEdge Caddyfile — multi-instance + security hardened
{
	email {$ACME_EMAIL}

	# Shared storage (certificates + rate-limit state)
	storage redis {
		address {$REDIS_ADDR:redis:6379}
		password {$REDIS_PASSWORD:}
		db 0
		key_prefix caddy
		timeout 5
	}

	# CrowdSec bouncer (local or central LAPI)
	crowdsec {
		api_url {$CROWDSEC_LAPI_URL:http://crowdsec:8080}
		api_key {$CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
	}

	# Header size limit (mitigates header bombs)
	servers {
		max_header_size 32KiB
	}

	order coraza_waf first
	order crowdsec_http before reverse_proxy
	order rate_limit before reverse_proxy

	# Admin API off by default (least privilege)
	admin off
}

{$DOMAIN} {
	# Explicit modern TLS
	tls {
		protocols tls1.2 tls1.3
	}

	# Optional DNS-01 (see docs/dns-challenge.md)
	# tls {
	# 	dns cloudflare {$CF_API_TOKEN}
	# }

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		-Server
	}

	# Block common attack / scanner paths early
	@badpaths path /wp-admin* /wp-login* /xmlrpc.php /.env /.git* /phpmyadmin* /admin.php /config.php /backup* /shell* /cgi-bin*
	handle @badpaths {
		respond "Forbidden" 403
	}

	# Lightweight bot / scraper User-Agent blocking
	@badbots header_regexp User-Agent (?i)(bot|crawler|spider|scraper|curl|wget|python-requests|go-http-client|java/|libwww|httpclient|scrapy|headless|phantom|selenium|playwright|puppeteer|axios|httpx)
	handle @badbots {
		respond "Forbidden" 403
	}

	# Multi-zone rate limiting
	rate_limit {
		distributed {
			read_interval 5s
			write_interval 5s
		}
		zone general {
			key {remote_host}
			events 120
			window 1m
		}
		zone sensitive {
			match {
				path /login* /admin* /api/auth* /wp-login* /xmlrpc.php
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	# Coraza WAF with body limits
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine DetectionOnly
			# SecRuleEngine On
			SecRequestBodyAccess On
			SecRequestBodyLimit 10485760
			SecRequestBodyNoFilesLimit 131072
			SecRequestBodyLimitAction Reject
			SecResponseBodyAccess Off
		`
	}

	# CrowdSec IP blocking
	crowdsec

	# Reverse proxy to upstream
	# Prefer https:// for the origin. Add header_up for origin auth if used.
	reverse_proxy {$UPSTREAM} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# Optional origin authentication (uncomment and set ORIGIN_SECRET)
		# header_up X-OpenEdge-Secret {$ORIGIN_SECRET}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}
}

# Health endpoint (private to load balancer)
:8080 {
	respond "ok" 200
}
