# OpenEdge Caddyfile — multi-instance + DNS challenge ready
# Shared Redis storage handles certificates and rate-limit state
{
	email {$ACME_EMAIL}

	# Shared storage (certificates + rate-limit state)
	storage redis {
		address {$REDIS_ADDR:redis:6379}
		password {$REDIS_PASSWORD:}
		db 0
		key_prefix caddy
		timeout 5
	}

	# CrowdSec bouncer
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
	}

	# Order matters
	order coraza_waf first
	order crowdsec_http before reverse_proxy
	order rate_limit before reverse_proxy

	# Uncomment to disable admin API in production
	# admin off
}

# Default site
{$DOMAIN} {
	# Optional DNS-01 challenge (recommended for multi-instance)
	# Uncomment and set the matching environment variables
	# See docs/dns-challenge.md
	#
	# tls {
	# 	dns cloudflare {$CF_API_TOKEN}
	# }
	# tls {
	# 	dns route53 {
	# 		access_key_id {$AWS_ACCESS_KEY_ID}
	# 		secret_access_key {$AWS_SECRET_ACCESS_KEY}
	# 		region {$AWS_REGION:us-east-1}
	# 	}
	# }
	# tls {
	# 	dns azure {
	# 		subscription_id {$AZURE_SUBSCRIPTION_ID}
	# 		resource_group_name {$AZURE_RESOURCE_GROUP_NAME}
	# 		tenant_id {$AZURE_TENANT_ID}
	# 		client_id {$AZURE_CLIENT_ID}
	# 		client_secret {$AZURE_CLIENT_SECRET}
	# 	}
	# }

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Distributed rate limiting (shared via Redis)
	rate_limit {
		distributed {
			read_interval 5s
			write_interval 5s
		}
		zone default {
			key {remote_host}
			events 100
			window 1m
		}
	}

	# Coraza WAF (DetectionOnly by default — switch to On after tuning)
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine DetectionOnly
			# SecRuleEngine On
		`
	}

	# CrowdSec IP blocking
	crowdsec

	# Reverse proxy to upstream
	reverse_proxy {$UPSTREAM} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Access logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}
}

# Health endpoint for load balancer checks
:8080 {
	respond "ok" 200
}
