# OpenEdge environment
# Copy to .env and edit before first run

# --- Required ---

# Email used by Caddy for Let's Encrypt account
ACME_EMAIL=admin@example.com

# Domain to protect (must resolve to this node or your load balancer)
DOMAIN=example.com

# Backend upstream (change to your real origin)
UPSTREAM=http://whoami:80

# Strong random key for CrowdSec bouncer
# Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme_generate_a_strong_key

# --- Redis (shared certificates + rate limits) ---

# Redis address. Use the service name for single-node, or private endpoint for multi-instance.
REDIS_ADDR=redis:6379

# Redis password (strongly recommended in multi-instance)
REDIS_PASSWORD=

# --- CrowdSec ---

# Local by default. Point all nodes at one central LAPI for multi-instance.
CROWDSEC_LAPI_URL=http://crowdsec:8080

# --- Optional: Anubis bot challenge ---
# Set UPSTREAM=http://anubis:3000 and start with --profile bot-challenge
# ANUBIS_TARGET=http://whoami:80
# ANUBIS_DIFFICULTY=4

# --- Optional: DNS-01 challenge (recommended for multi-instance) ---
# Uncomment the matching tls block in caddy/Caddyfile and set one provider below.
# See docs/dns-challenge.md

# Cloudflare
# CF_API_TOKEN=

# AWS Route 53
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure DNS
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
