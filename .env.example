# OpenEdge environment
# Copy to .env and edit

# Email used by Caddy for Let's Encrypt
ACME_EMAIL=admin@example.com

# CrowdSec bouncer API key (generate a strong random value)
# openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme_generate_a_strong_key

# Domain to protect
DOMAIN=example.com

# Backend upstream
UPSTREAM=http://whoami:80

# Redis address for shared rate-limit state
# Local: redis:6379
# Multi-instance: redis.example.com:6379 or Azure/AWS Redis endpoint
REDIS_ADDR=redis:6379
