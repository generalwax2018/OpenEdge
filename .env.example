# OpenEdge environment
# Copy to .env and edit

# Email used by Caddy for Let's Encrypt
ACME_EMAIL=admin@example.com

# CrowdSec bouncer API key (generate a strong random value)
# openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme_generate_a_strong_key

# CrowdSec LAPI URL (local by default; set to central LAPI for multi-instance)
CROWDSEC_LAPI_URL=http://crowdsec:8080

# Domain to protect
DOMAIN=example.com

# Backend upstream
# Default: http://whoami:80
# With Anubis bot challenge: http://anubis:3000
UPSTREAM=http://whoami:80

# Redis address for shared certificates + rate-limit state
REDIS_ADDR=redis:6379

# Redis password (leave empty if none)
REDIS_PASSWORD=

# --- Optional Anubis bot challenge ---
# ANUBIS_TARGET=http://whoami:80
# ANUBIS_DIFFICULTY=4

# --- DNS-01 challenge (optional) ---
# See docs/dns-challenge.md
# CF_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
