# OpenEdge environment
# Copy to .env and edit

# Email used by Caddy for Let's Encrypt
ACME_EMAIL=admin@example.com

# CrowdSec bouncer API key (generate a strong random value)
# openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme_generate_a_strong_key

# Domain to protect
DOMAIN=example.com

# Backend upstream
UPSTREAM=http://whoami:80

# Redis address for shared certificates + rate-limit state
REDIS_ADDR=redis:6379

# Redis password (leave empty if none)
REDIS_PASSWORD=

# --- DNS-01 challenge (optional, recommended for multi-instance) ---
# Uncomment the matching tls block in caddy/Caddyfile and set one of the following

# Cloudflare
# CF_API_TOKEN=

# AWS Route 53
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure DNS
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
