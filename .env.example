# OpenEdge environment
# Copy to .env and edit

# Email used by Caddy for Let's Encrypt (required for production)
ACME_EMAIL=admin@example.com

# CrowdSec bouncer API key (generate after first start, or set a strong random value)
# openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme_generate_a_strong_key

# Domain you want to protect (used in example Caddyfile)
# Leave blank for local testing on :80/:443 with self-signed or no domain
DOMAIN=example.com

# Backend upstream (service name or host:port)
UPSTREAM=http://whoami:80
